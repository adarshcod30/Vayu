# VAYU scheduled jobs (ingest+score hourly, retrain weekly). Same code image as
# the API; the EventBridge target overrides the command per schedule.
FROM python:3.11-slim

ENV PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1
WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends libgomp1 \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install -r requirements.txt

COPY vayu_core/ vayu_core/
COPY services/ services/
COPY config/ config/
COPY data/samples/ data/samples/
COPY models/artifacts/ models/artifacts/

# Default to the hourly refresh; the weekly EventBridge rule overrides this with
# ["python","-m","services.jobs.retrain"].
CMD ["python", "-m", "services.jobs.refresh"]
